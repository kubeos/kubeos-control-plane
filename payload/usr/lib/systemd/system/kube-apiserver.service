# KubeOS: kube-apiserver as a native systemd service.
#
# Part of the "no base Pods" design (docs/NATIVE-CONTROL-PLANE.md). The flag set is
# the one kubeadm writes into its static Pod manifest; what is gone is everything
# that only exists because that manifest ran inside a Pod (the hostPath copies of
# the PKI under /etc/kubernetes/pki, and the 127.0.0.1 binds of a Pod network
# namespace). Here the paths are real host paths.
#
# Requires=etcd is not enough on its own to guarantee etcd is *listening*: etcd is
# Type=notify, so its start job only completes when it has written its socket, and
# that is what this unit waits for.
#
# ${NODE_IP} and ${SERVICE_CIDR} are expanded by systemd from
# /etc/kubeos/cluster-network.conf. NODE_IP is a Phase 8 requirement on
# node-setup (docs/NATIVE-CONTROL-PLANE.md).
[Unit]
Description=KubeOS kube-apiserver
Documentation=https://kubeos.in/
ConditionPathExists=/etc/kubernetes/pki/apiserver.crt
Requires=etcd.service
After=etcd.service network-online.target
Before=kube-controller-manager.service kube-scheduler.service kubelet.service

[Service]
Type=exec
EnvironmentFile=/etc/kubeos/cluster-network.conf
ExecStart=/usr/bin/kube-apiserver \
    --advertise-address=${NODE_IP} \
    --bind-address=0.0.0.0 \
    --secure-port=6443 \
    --allow-privileged=true \
    --authorization-mode=Node,RBAC \
    --anonymous-auth=false \
    --client-ca-file=/etc/kubernetes/pki/ca.crt \
    --enable-admission-plugins=NodeRestriction \
    --enable-bootstrap-token-auth=true \
    --etcd-servers=https://127.0.0.1:2379 \
    --etcd-cafile=/etc/kubernetes/pki/etcd/ca.crt \
    --etcd-certfile=/etc/kubernetes/pki/apiserver-etcd-client.crt \
    --etcd-keyfile=/etc/kubernetes/pki/apiserver-etcd-client.key \
    --kubelet-client-certificate=/etc/kubernetes/pki/apiserver-kubelet-client.crt \
    --kubelet-client-key=/etc/kubernetes/pki/apiserver-kubelet-client.key \
    --kubelet-preferred-address-types=InternalIP,ExternalIP,Hostname \
    --proxy-client-cert-file=/etc/kubernetes/pki/front-proxy-client.crt \
    --proxy-client-key-file=/etc/kubernetes/pki/front-proxy-client.key \
    --requestheader-allowed-names=front-proxy-client \
    --requestheader-client-ca-file=/etc/kubernetes/pki/front-proxy-ca.crt \
    --requestheader-extra-headers-prefix=X-Remote-Extra- \
    --requestheader-group-headers=X-Remote-Group \
    --requestheader-username-headers=X-Remote-User \
    --service-account-issuer=https://kubernetes.default.svc.cluster.local \
    --service-account-key-file=/etc/kubernetes/pki/sa.pub \
    --service-account-signing-key-file=/etc/kubernetes/pki/sa.key \
    --service-cluster-ip-range=${SERVICE_CIDR} \
    --service-node-port-range=30000-32767 \
    --tls-cert-file=/etc/kubernetes/pki/apiserver.crt \
    --tls-private-key-file=/etc/kubernetes/pki/apiserver.key
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target

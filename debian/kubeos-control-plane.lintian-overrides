
# /usr/local/bin holds two SYMLINKS (etcd, etcdctl) to the real binaries in /usr/bin, because the
# dashboard console calls /usr/local/bin/etcdctl by name (console.py, hard-coded path). Shipping
# them keeps the Snapshot page working on a packaged node; the alternative is to fix console.py to
# search PATH, which is the cleaner fix and is tracked as an open item.
kubeos-control-plane: dir-in-usr-local
kubeos-control-plane: file-in-usr-local

# The six binaries are the upstream Go builds (etcd, etcdctl, kube-apiserver, kube-controller-manager,
# kube-scheduler, kube-proxy): Go binaries are static by construction. KubeOS runs them as host
# services instead of containers, so shipping them is the point of this package.
kubeos-control-plane: statically-linked-binary
